<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Typers</title>
    <welcome>Typers is a block-based Markdown editor built with Rust and GPUI.</welcome>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="Typers"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="Typers" title="Install Typers" description="Install Typers to /Applications">
        <pkg-ref id="com.ariakeumi.Typers"/>
    </choice>
    <pkg-ref id="com.ariakeumi.Typers" version="__VELOTYPE_VERSION__" onConclusion="none">#Typers-component.pkg</pkg-ref>
</installer-gui-script>
